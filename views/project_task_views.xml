<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add annotation button and smart button to FSM task form -->
    <record id="view_task_form_inherit_annotation" model="ir.ui.view">
        <field name="name">project.task.form.inherit.annotation</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!-- Smart Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_annotations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-camera"
                        invisible="annotation_count == 0">
                    <field name="annotation_count"
                           widget="statinfo"
                           string="Annotationen"/>
                </button>
            </xpath>

            <!-- Button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_new_annotation"
                        type="object"
                        string="Bild annotieren"
                        icon="fa-pencil"
                        class="btn-secondary"
                        invisible="not is_fsm"/>
            </xpath>

        </field>
    </record>

</odoo>
