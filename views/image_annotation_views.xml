<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_face_image_annotation_list" model="ir.ui.view">
        <field name="name">face.image.annotation.list</field>
        <field name="model">face.image.annotation</field>
        <field name="arch" type="xml">
            <list string="Bild-Annotationen">
                <field name="name"/>
                <field name="task_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="annotation_count" string="Anmerkungen"/>
                <field name="create_date" string="Erstellt am"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_face_image_annotation_form" model="ir.ui.view">
        <field name="name">face.image.annotation.form</field>
        <field name="model">face.image.annotation</field>
        <field name="arch" type="xml">
            <form string="Bild-Annotation">
                <header>
                    <button name="action_open_annotator"
                            type="object"
                            string="Annotator öffnen"
                            class="btn-primary"
                            icon="fa-pencil"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Bezeichnung..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="task_id"
                                   domain="[('is_fsm', '=', True)]"
                                   context="{'default_is_fsm': True}"/>
                            <field name="project_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="annotation_count"/>
                            <field name="create_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bilder" name="images">
                            <group>
                                <group string="Originalbild">
                                    <field name="original_image" widget="image"
                                           options="{'size': [400, 400]}"/>
                                </group>
                                <group string="Annotiertes Bild">
                                    <field name="annotated_image" widget="image"
                                           options="{'size': [400, 400]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notizen" name="notes">
                            <field name="note" placeholder="Notizen zur Annotation..."/>
                        </page>
                        <page string="Technisch" name="technical" groups="base.group_no_one">
                            <field name="annotations_json"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_face_image_annotation_kanban" model="ir.ui.view">
        <field name="name">face.image.annotation.kanban</field>
        <field name="model">face.image.annotation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="annotated_image"/>
                <field name="user_id"/>
                <field name="task_id"/>
                <field name="annotation_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image" t-if="record.annotated_image.raw_value">
                            <img t-att-src="kanban_image('face.image.annotation', 'annotated_image', record.id.raw_value)"
                                 alt="Annotation" class="o_image_64_contain"/>
                        </div>
                        <div class="o_kanban_image" t-else="">
                            <img t-att-src="kanban_image('face.image.annotation', 'original_image', record.id.raw_value)"
                                 alt="Original" class="o_image_64_contain"/>
                        </div>
                        <div>
                            <strong><field name="name"/></strong>
                            <div t-if="record.task_id.value">
                                <i class="fa fa-wrench me-1"/>
                                <field name="task_id"/>
                            </div>
                            <div class="text-muted">
                                <field name="annotation_count"/> Anmerkungen
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_face_image_annotation_search" model="ir.ui.view">
        <field name="name">face.image.annotation.search</field>
        <field name="model">face.image.annotation</field>
        <field name="arch" type="xml">
            <search string="Annotationen suchen">
                <field name="name"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <filter name="my_annotations"
                        string="Meine Annotationen"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="with_task"
                        string="Mit Aufgabe"
                        domain="[('task_id', '!=', False)]"/>
                <group expand="0" string="Gruppieren nach">
                    <filter name="group_task" string="Aufgabe" context="{'group_by': 'task_id'}"/>
                    <filter name="group_project" string="Projekt" context="{'group_by': 'project_id'}"/>
                    <filter name="group_user" string="Ersteller" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_face_image_annotation" model="ir.actions.act_window">
        <field name="name">Bild-Annotationen</field>
        <field name="res_model">face.image.annotation</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_face_image_annotation_search"/>
        <field name="context">{'search_default_my_annotations': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Noch keine Bild-Annotationen vorhanden
            </p>
            <p>
                Erstellen Sie Annotationen über den Menüpunkt oder direkt aus einer Außendienst-Aufgabe.
            </p>
        </field>
    </record>

    <!-- Client Action for the Annotator -->
    <record id="action_face_annotator_client" model="ir.actions.client">
        <field name="name">Bild annotieren</field>
        <field name="tag">face_image_annotator</field>
    </record>

</odoo>
